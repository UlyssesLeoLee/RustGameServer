# RGS 6 独立数据库 + superuser 连接信息模板
# 复制本文件为 .env 并填入实际值（dev 仅本地不入 git）
#
# cp .env.example .env
# vim .env  # 改密码等
#
# .env 已被 .gitignore 忽略（per .gitignore 第 6 行）

# ============================================================
# 0. 全局
# ============================================================
RUST_LOG=info

# ============================================================
# 1. PostgreSQL 18.6 连接
# ============================================================
# 1.1 k3s 集群内 Service DNS（5 域微服务用）
PG_HOST_IN_CLUSTER=postgres.rust-game-server.svc.cluster.local
PG_PORT=5432

# 1.2 本机端口转发（Windows 端 sqlx-cli / psql 用，per scripts/port_forward_pg.ps1）
#    注意端口：kubectl port-forward 默认 15432（避免和 Windows 本地可能装的 PG 冲突）
PG_HOST_LOCAL=127.0.0.1
PG_PORT_LOCAL=15432

# ============================================================
# 2. superuser（postgres）— 仅用于 migration / 管理
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
POSTGRES_SUPERUSER_URL=postgres://postgres:CHANGE_ME_SUPERUSER_PASSWORD@127.0.0.1:15432/postgres

# ============================================================
# 3. 6 独立数据库（per ARC-008）
#    - player_db   (player 域)
#    - economy_db  (economy 域，Reservation 模式 + 幂等)
#    - match_db    (match 域)
#    - social_db   (social 域)
#    - admin_db    (admin 域，COC 控制面)
#    - cluster_ops_db (cluster-ops 域，Active-Active + saga_store 9 表)
#    模板：每个域独立 schema + 独立 user + 独立密码
# ============================================================

# --- player_db ---
PLAYER_DB_NAME=player_db
PLAYER_DB_USER=player_user
PLAYER_DB_PASSWORD=CHANGE_ME_PLAYER_PASSWORD
PLAYER_DATABASE_URL=postgres://player_user:CHANGE_ME_PLAYER_PASSWORD@127.0.0.1:15432/player_db

# --- economy_db ---
ECONOMY_DB_NAME=economy_db
ECONOMY_DB_USER=economy_user
ECONOMY_DB_PASSWORD=CHANGE_ME_ECONOMY_PASSWORD
ECONOMY_DATABASE_URL=postgres://economy_user:CHANGE_ME_ECONOMY_PASSWORD@127.0.0.1:15432/economy_db

# --- match_db ---
MATCH_DB_NAME=match_db
MATCH_DB_USER=match_user
MATCH_DB_PASSWORD=CHANGE_ME_MATCH_PASSWORD
MATCH_DATABASE_URL=postgres://match_user:CHANGE_ME_MATCH_PASSWORD@127.0.0.1:15432/match_db

# --- social_db ---
SOCIAL_DB_NAME=social_db
SOCIAL_DB_USER=social_user
SOCIAL_DB_PASSWORD=CHANGE_ME_SOCIAL_PASSWORD
SOCIAL_DATABASE_URL=postgres://social_user:CHANGE_ME_SOCIAL_PASSWORD@127.0.0.1:15432/social_db

# --- admin_db ---
ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=admin_user
ADMIN_DB_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_DATABASE_URL=postgres://admin_user:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:15432/admin_db

# --- cluster_ops_db ---
CLUSTER_OPS_DB_NAME=cluster_ops_db
CLUSTER_OPS_DB_USER=cluster_ops_user
CLUSTER_OPS_DB_PASSWORD=CHANGE_ME_CLUSTER_OPS_PASSWORD
CLUSTER_OPS_DATABASE_URL=postgres://cluster_ops_user:CHANGE_ME_CLUSTER_OPS_PASSWORD@127.0.0.1:15432/cluster_ops_db

# ============================================================
# 4. sqlx-cli 默认 DATABASE_URL
# ============================================================
# 默认连 player_db（开发期主用）
DATABASE_URL=postgres://player_user:CHANGE_ME_PLAYER_PASSWORD@127.0.0.1:15432/player_db

# ============================================================
# 5. NATS JetStream（per RGS-BAS-100 §5 + DEC-011）
# ============================================================
NATS_URL_IN_CLUSTER=nats://nats.rust-game-server.svc.cluster.local:4222
NATS_URL_LOCAL=nats://127.0.0.1:14222

# ============================================================
# 6. k3s 部署相关
# ============================================================
K8S_NAMESPACE=rust-game-server
K8S_KUBECTL=k3s kubectl
K8S_CONTEXT=
K8S_KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# ============================================================
# 7. OTel / Prometheus / Grafana
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4317
OTEL_SERVICE_NAME=rgs-dev

      "startNodeId": "N-103-svc-gm-backend",
      "precondition": "admin-service 持续不可用",
      "steps": [
        {
          "seq": 1,
          "actor": "N-103-svc-gm-backend",
          "action": "call",
          "target": "N-096-svc-admin-service",
          "expect": "失败 1/5, 仍 Closed"
        },
        {
          "seq": 2,
          "actor": "N-103-svc-gm-backend",
          "action": "call",
          "target": "N-096-svc-admin-service",
          "expect": "第 5 次失败 → Open"
        },
        {
          "seq": 3,
          "actor": "N-103-svc-gm-backend",
          "action": "call",
          "target": "N-096-svc-admin-service",
          "expect": "Open 期间短路, 不打下游"
        },
        {
          "seq": 4,
          "actor": "N-103-svc-gm-backend",
          "action": "probe",
          "target": "N-096-svc-admin-service",
          "expect": "等待 30000ms 后 HalfOpen, 仅 1 个 probe"
        }
      ],
      "expectedOutcome": "FAILURE — 熔断生效, 防止 cascade failure",
      "nodeIds": [
        "N-103-svc-gm-backend",
        "N-096-svc-admin-service"
      ],

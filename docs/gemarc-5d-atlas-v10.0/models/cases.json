        {
          "seq": 2,
          "actor": "N-123-svc-shared-platform",
          "action": "backoff",
          "expect": "等待 ~100ms"
        },
        {
          "seq": 3,
          "actor": "N-123-svc-shared-platform",
          "action": "call",
          "expect": "再次失败"
        },
        {
          "seq": 4,
          "actor": "N-123-svc-shared-platform",
          "action": "backoff",
          "expect": "等待 ~200ms"
        }
      ],
      "expectedOutcome": "FAILURE — 达到 max_retries=3 后放弃 (退避上限 30000ms)",

{
  "meta": {
    "version": "10.0.0",
    "generatedBy": "scripts/generate-meta-models.mjs",
    "isolation": "すべての追加/遮蔽/変更は ScenarioGraphDelta に属する。正式な事実グラフは不変。実験の採用は設計変更提案を経由する。"
  },
  "customElementTemplates": [
    {
      "template": "Cache",
      "kind": "Processor",
      "typedInputPorts": [
        "request"
      ],
      "typedOutputPorts": [
        "hit",
        "miss"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Completed"
      ],
      "guardAst": "cache.contains(key)",
      "eventHandlers": [
        "onRequest"
      ],
      "errorRules": [
        "onCapacityExceeded"
      ],
      "resourceLimits": {
        "maxEntries": 10000
      },
      "terminationCondition": "single response"
    },
    {
      "template": "Validator",
      "kind": "Processor",
      "typedInputPorts": [
        "payload"
      ],
      "typedOutputPorts": [
        "valid",
        "invalid"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Completed"
      ],
      "guardAst": "schema.valid(payload)",
      "eventHandlers": [
        "onPayload"
      ],
      "errorRules": [
        "onSchemaViolation"
      ],
      "resourceLimits": {},
      "terminationCondition": "single verdict"
    },
    {
      "template": "Proxy",
      "kind": "Processor",
      "typedInputPorts": [
        "request"
      ],
      "typedOutputPorts": [
        "response",
        "error"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Waiting",
        "Completed",
        "Failed"
      ],
      "guardAst": "upstream.healthy",
      "eventHandlers": [
        "onRequest",
        "onUpstreamError"
      ],
      "errorRules": [
        "onTimeout"
      ],
      "resourceLimits": {
        "timeoutMs": 5000
      },
      "terminationCondition": "single response"
    },
    {
      "template": "MessageQueue",
      "kind": "Processor",
      "typedInputPorts": [
        "message"
      ],
      "typedOutputPorts": [
        "ack",
        "nack"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Waiting",
        "Completed"
      ],
      "guardAst": "queue.hasCapacity",
      "eventHandlers": [
        "onMessage",
        "onAck",
        "onNack"
      ],
      "errorRules": [
        "onPoisonMessage"
      ],
      "resourceLimits": {
        "maxDepth": 1000
      },
      "terminationCondition": "ack or nack"
    },
    {
      "template": "CircuitBreaker",
      "kind": "Processor",
      "typedInputPorts": [
        "call"
      ],
      "typedOutputPorts": [
        "pass",
        "shortCircuit"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Waiting",
        "Completed",
        "Failed",
        "Recovered"
      ],
      "guardAst": "state != Open",
      "eventHandlers": [
        "onCall",
        "onSuccess",
        "onFailure"
      ],
      "errorRules": [
        "onThreshold"
      ],
      "resourceLimits": {
        "failureThreshold": 5,
        "openDurationMs": 30000
      },
      "terminationCondition": "pass or shortCircuit"
    },
    {
      "template": "FaultSource",
      "kind": "Actor",
      "typedInputPorts": [
        "trigger"
      ],
      "typedOutputPorts": [
        "fault"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Completed"
      ],
      "guardAst": "enabled",
      "eventHandlers": [
        "onTrigger"
      ],
      "errorRules": [],
      "resourceLimits": {},
      "terminationCondition": "single fault"
    },
    {
      "template": "RetryHandler",
      "kind": "Processor",
      "typedInputPorts": [
        "call"
      ],
      "typedOutputPorts": [
        "result",
        "giveUp"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Waiting",
        "Completed",
        "Failed"
      ],
      "guardAst": "isRetryable(error.code)",
      "eventHandlers": [
        "onCall",
        "onError"
      ],
      "errorRules": [
        "onMaxRetries"
      ],
      "resourceLimits": {
        "maxRetries": 3,
        "initialIntervalMs": 100,
        "multiplier": 2,
        "maxIntervalMs": 30000,
        "jitter": 0.2
      },
      "terminationCondition": "result or giveUp"
    },
    {
      "template": "RecoveryHandler",
      "kind": "Processor",
      "typedInputPorts": [
        "state"
      ],
      "typedOutputPorts": [
        "recovered",
        "stillFailed"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Waiting",
        "Recovered",
        "Failed"
      ],
      "guardAst": "probe.allowed",
      "eventHandlers": [
        "onProbe",
        "onProbeSuccess",
        "onProbeFailure"
      ],
      "errorRules": [
        "onProbeFailure"
      ],
      "resourceLimits": {
        "probeLimit": 1
      },
      "terminationCondition": "recovered or stillFailed"
    },
    {
      "template": "ExternalStub",
      "kind": "Interface",
      "typedInputPorts": [
        "request"
      ],
      "typedOutputPorts": [
        "response"
      ],
      "stateMachine": [
        "Idle",
        "Running",
        "Completed",
        "Failed"
      ],
      "guardAst": "stub.available",
      "eventHandlers": [
        "onRequest"
      ],
      "errorRules": [
        "onUnavailable"
      ],
      "resourceLimits": {},
      "terminationCondition": "single response"
    }
  ],

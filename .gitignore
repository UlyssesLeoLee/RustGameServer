.claude/
.serena/
__pycache__/
.worktree.env
# Cargo build artifacts (per 2026-08-27 16:48 self-review 发现历史漏洞)
# RGS 仓库的 [profile.release] 配置下 target/ 持续增长,
# 此前未在 .gitignore 中导致 git add -A 会把 6000+ .d / .rlib / .rmeta 全 stage
/target/
**/target/
target/
**/x86_64-unknown-linux-gnu/
**/x86_64-unknown-linux-musl/

# Local env files（含 DB 密码 / NATS / K8s 等敏感信息，per RGS-SEC-100 §7 Secret 管理）
.env
.env.local
.env.*.local

# .env.example 模板（无敏感值）应入 git

# Reviewer worktree cargo 输出（per RGS-REV-009 COMMIT_PROPOSAL §65
# + RGS-REV-010 _total §11: V1-V5 verifier 落盘的 cargo log 不入 commit,
# 留作临时调试材料, 避免污染 review 报告 diff）
docs/00-**/reviews/**/cargo-*.log

# Agent session 临时工作目录(per 2026-08-24 主对话决策)
# 内容: session 内的 grep extract / b1 evidence copy / regression log 等
# 这些是过程产物,不进 git 也不归档
.run-logs/

# 隔离 0 字节误建文件 + session 临时删除缓冲
.git-trash/

# tools/rgs-web/ 依赖(per RGS-WEB-PLAN-2026-08-26 §6.2 npm install SOP)
# server.js 是备选实现,server-no-deps.js 是当前运行版(零依赖,无 node_modules)
# node_modules 实际未在 commit(per commit 5f827ee),规则是预防未来 npm install 误入
tools/rgs-web/node_modules/

# Rust cargo 构建输出 (per 2026-08-27 本地 k3s 部署后产生的 untracked target/)
# 模式仅匹配仓库根 target/, 不影响 nested crate (e.g. crates/*/target 仍可显式
# 排除于各子 crate 自身的 .gitignore 或本文件后续追加)
target/

# Worker 临时脚手架目录(per 2026-08-26 清理决议)
# 内容: WT 清理 / DTL-036 v0.2 patch 等一次性 Python 脚本
# 任务执行后脚手架即失效,不入 git 也不归档(参考 .run-logs/ / .git-trash/ 治理先例)
.worker-tmp/

# scripts/_scratch/ (per 2026-08-27 16:48 self-review)
# 其他 session 跑 RGS-INC-002 cross-ref 验证时的临时 Python 脚本 + 临时输出
# 15 个文件 622KB,跑完即失效,不入 git 也不归档
scripts/_scratch/

# test-evidence (per 2026-08-28 ut 实施批次,test-evidence.ps1 输出)
# 内容:cargo test / cargo example / e2e-smoke 留档 log + manifest.json
# 不入 git (DDD Review 阶段需查档时手动从本机 / CI 复跑生成)
docs/00-基准与治理/.test-evidence/*/cargo-*.log
docs/00-基准与治理/.test-evidence/*/e2e-smoke.log
docs/00-基准与治理/.test-evidence/*/manifest.json

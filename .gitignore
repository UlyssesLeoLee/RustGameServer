.claude/
.serena/
__pycache__/
.worktree.env

# Local env files（含 DB 密码 / NATS / K8s 等敏感信息，per RGS-SEC-100 §7 Secret 管理）
.env
.env.local
.env.*.local

# .env.example 模板（无敏感值）应入 git

# Reviewer worktree cargo 输出（per RGS-REV-009 COMMIT_PROPOSAL §65
# + RGS-REV-010 _total §11: V1-V5 verifier 落盘的 cargo log 不入 commit,
# 留作临时调试材料, 避免污染 review 报告 diff）
docs/00-**/reviews/**/cargo-*.log

# Agent session 临时工作目录(per 2026-08-24 主对话决策)
# 内容: session 内的 grep extract / b1 evidence copy / regression log 等
# 这些是过程产物,不进 git 也不归档
.run-logs/

# 隔离 0 字节误建文件 + session 临时删除缓冲
.git-trash/

# tools/rgs-web/ 依赖(per RGS-WEB-PLAN-2026-08-26 §6.2 npm install SOP)
# server.js 是备选实现,server-no-deps.js 是当前运行版(零依赖,无 node_modules)
# node_modules 实际未在 commit(per commit 5f827ee),规则是预防未来 npm install 误入
tools/rgs-web/node_modules/
